# JustClothing Backend Environment Configuration Template
# Copy this file to .env and fill in your values
# IMPORTANT: Keep this file secure and never commit to version control

################################################################################
# CORE DJANGO SETTINGS
################################################################################

# Django Secret Key - Generate a new one for production
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-super-secret-key-here-change-this-in-production

# Debug Mode - NEVER set to True in production
DEBUG=False

# Allowed hosts for your Django application (comma-separated)
ALLOWED_HOSTS=justclothing.store,www.justclothing.store,api.justclothing.store,localhost,127.0.0.1

################################################################################
# DATABASE CONFIGURATION
################################################################################

# PostgreSQL Database Settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=justclothing_db
DB_USER=justclothing_user
DB_PASSWORD=your-secure-database-password-here
DB_HOST=localhost
DB_PORT=5432

# Optional: PostgreSQL SSL Mode (disable, allow, require, prefer, require)
# DB_SSLMODE=disable

################################################################################
# REDIS CONFIGURATION
################################################################################

# Redis URL for caching and Celery
REDIS_URL=redis://localhost:6379/0

# Redis cache configuration (optional, can use REDIS_URL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

################################################################################
# CELERY CONFIGURATION (Background Tasks)
################################################################################

# Celery Broker (Redis)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery Result Backend
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Celery Timezone
CELERY_TIMEZONE=UTC

# Enable Celery Beat Scheduler
CELERY_BEAT_ENABLED=True

################################################################################
# MINIO OBJECT STORAGE CONFIGURATION
################################################################################

# MinIO Server Endpoint
MINIO_STORAGE_ENDPOINT=localhost:9000

# Use HTTPS for MinIO connections
MINIO_STORAGE_USE_HTTPS=True

# MinIO Access Key
MINIO_STORAGE_ACCESS_KEY=minioadmin

# MinIO Secret Key
MINIO_STORAGE_SECRET_KEY=minioadmin123

# MinIO Bucket Name
MINIO_STORAGE_BUCKET_NAME=justclothing-media

# Media URL for MinIO objects
MINIO_STORAGE_MEDIA_URL=https://your-domain.com/minio/

################################################################################
# AWS S3 CONFIGURATION (Alternative to MinIO)
################################################################################

# Use S3 instead of MinIO (True/False)
USE_S3=False

# AWS Access Key ID
AWS_ACCESS_KEY_ID=your-aws-access-key-id

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS S3 Bucket Name
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name

# AWS Region
AWS_S3_REGION_NAME=us-east-1

# AWS S3 URL
AWS_S3_CUSTOM_DOMAIN=cdn.your-domain.com

################################################################################
# EMAIL CONFIGURATION
################################################################################

# Email Backend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Server Host
EMAIL_HOST=smtp.gmail.com

# SMTP Server Port
EMAIL_PORT=587

# Use TLS (True/False)
EMAIL_USE_TLS=True

# SMTP Username/Email
EMAIL_HOST_USER=your-email@gmail.com

# SMTP App Password (not your Gmail password, use app-specific password)
EMAIL_HOST_PASSWORD=your-app-specific-password

# Default email sender
DEFAULT_FROM_EMAIL=noreply@justclothing.store

# Admin email for error notifications
ADMIN_EMAIL=admin@justclothing.store

# Alternative: Using SendGrid
# EMAIL_BACKEND=sendgrid_backend.SendgridBackend
# SENDGRID_API_KEY=your-sendgrid-api-key

# Alternative: Using AWS SES
# EMAIL_BACKEND=django_ses.SESBackend
# AWS_SES_REGION_NAME=us-east-1
# AWS_SES_REGION_ENDPOINT=email.us-east-1.amazonaws.com

################################################################################
# SECURITY SETTINGS
################################################################################

# HTTPS/SSL redirect
SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Secure Cookies
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://justclothing.store,https://www.justclothing.store

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=https://justclothing.store,https://www.justclothing.store

################################################################################
# GOOGLE OAUTH CONFIGURATION
################################################################################

# Google OAuth2 Client ID
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth2 Client Secret
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret

# Google OAuth2 Redirect URI
GOOGLE_OAUTH2_REDIRECT_URI=https://justclothing.store/auth/google/callback

################################################################################
# PAYMENT PROCESSING
################################################################################

# Stripe Configuration
STRIPE_API_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# PayPal Configuration
PAYPAL_MODE=live  # or sandbox for testing
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

################################################################################
# PHONE NUMBER VERIFICATION
################################################################################

# Twilio (for SMS/phone verification)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

################################################################################
# LOGGING CONFIGURATION
################################################################################

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log Directory
LOG_DIR=/var/log/justclothing

# Enable request logging
LOG_REQUESTS=True

# Enable database query logging
LOG_QUERIES=False

# Sentry Error Tracking (optional)
SENTRY_DSN=

################################################################################
# RATE LIMITING
################################################################################

# Enable rate limiting
RATE_LIMIT_ENABLED=True

# Rate limit requests per minute
RATE_LIMIT_PER_MINUTE=60

# Whitelist IPs (comma-separated, bypasses rate limiting)
RATE_LIMIT_WHITELIST=127.0.0.1

################################################################################
# CACHING
################################################################################

# Cache backend (redis, locmem, or dummy)
CACHE_BACKEND=redis

# Cache timeout in seconds (1 hour = 3600)
CACHE_TIMEOUT=3600

################################################################################
# API CONFIGURATION
################################################################################

# API Version
API_VERSION=v1

# API Page Size (pagination)
API_PAGE_SIZE=20

# API Rate Limit
API_RATE_LIMIT=1000/day

# API Timeout (seconds)
API_TIMEOUT=30

################################################################################
# FILE UPLOAD SETTINGS
################################################################################

# Maximum file upload size (bytes, default 100MB)
MAX_UPLOAD_SIZE=104857600

# Allowed file extensions (comma-separated)
ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# Image resize dimensions
IMAGE_MAX_WIDTH=2000
IMAGE_MAX_HEIGHT=2000
IMAGE_THUMBNAIL_SIZE=300

################################################################################
# SOCIAL MEDIA
################################################################################

# Facebook App ID
FACEBOOK_APP_ID=your_facebook_app_id

# Instagram Access Token
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Twitter API Keys
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret

################################################################################
# ANALYTICS & TRACKING
################################################################################

# Google Analytics ID
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Google Tag Manager ID
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# Hotjar ID
HOTJAR_ID=your_hotjar_id

################################################################################
# ENVIRONMENT
################################################################################

# Environment name (development, staging, production)
ENVIRONMENT=production

# App Version
APP_VERSION=1.0.0

# Time Zone
TIMEZONE=UTC

# Language Code
LANGUAGE_CODE=en-us

################################################################################
# BACKUP SETTINGS
################################################################################

# Database backup enabled
BACKUP_ENABLED=True

# Backup schedule (cron format, default: 2 AM UTC)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention days
BACKUP_RETENTION_DAYS=30

################################################################################
# MONITORING
################################################################################

# Health check enabled
HEALTH_CHECK_ENABLED=True

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=300

# Uptime monitoring service
UPTIME_MONITOR_URL=https://uptime.justclothing.store/ping

################################################################################
# FEATURE FLAGS
################################################################################

# Enable new product page
FEATURE_NEW_PRODUCT_PAGE=True

# Enable mobile app
FEATURE_MOBILE_APP=True

# Enable wishlist feature
FEATURE_WISHLIST=True

# Enable product recommendations
FEATURE_RECOMMENDATIONS=True

# Enable live chat support
FEATURE_LIVE_CHAT=True

################################################################################
# INTERNAL SETTINGS (Don't modify unless you know what you're doing)
################################################################################

# Django settings module
DJANGO_SETTINGS_MODULE=justclothing.settings

# Allowed file upload extensions
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,pdf,doc,docx,xls,xlsx,zip

# Celery concurrency
CELERY_WORKER_CONCURRENCY=4

# Celery task time limit (seconds)
CELERY_TASK_TIME_LIMIT=3600

# Database connection pool size
DB_CONN_MAX_AGE=600

# Number of Gunicorn workers (2 * CPU_CORES + 1)
GUNICORN_WORKERS=4

# Gunicorn worker class
GUNICORN_WORKER_CLASS=sync

# Gunicorn bind address
GUNICORN_BIND=127.0.0.1:8000

################################################################################
# NOTES
################################################################################

# IMPORTANT SECURITY REMINDERS:
# 1. Never commit this file to version control
# 2. Use strong, random passwords
# 3. Rotate secrets regularly
# 4. Use environment variables in production
# 5. Use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# 6. Enable 2FA on all external services (Gmail, AWS, etc.)
# 7. Regularly audit and update dependencies
# 8. Use HTTPS everywhere
# 9. Enable CORS only for your domain
# 10. Monitor logs for suspicious activity

